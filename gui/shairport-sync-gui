#!/usr/bin/env python3
"""AirPlay Receiver -- a now-playing window for Shairport Sync.

Reads the MPRIS and native D-Bus interfaces that shairport-sync publishes on
the session bus (set dbus_service_bus and mpris_service_bus to "session") and
drives a Kirigami UI. It also starts and stops the receiver's systemd --user
units (shairport-sync.service and nqptp.service).
"""

import json
import os
import re
import shutil
import sys
from pathlib import Path

from PyQt6.QtCore import QObject, QProcess, QTimer, QUrl, pyqtProperty, pyqtSignal, pyqtSlot
from PyQt6.QtDBus import QDBus, QDBusConnection, QDBusMessage, QDBusServiceWatcher
from PyQt6.QtGui import QDesktopServices, QIcon
from PyQt6.QtQml import QQmlApplicationEngine
from PyQt6.QtWidgets import QApplication

HERE = Path(__file__).resolve().parent

MPRIS_SERVICE = "org.mpris.MediaPlayer2.ShairportSync"
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_PLAYER = "org.mpris.MediaPlayer2.Player"
SPS_SERVICE = "org.gnome.ShairportSync"
SPS_PATH = "/org/gnome/ShairportSync"
SPS_IFACE = "org.gnome.ShairportSync"
SPS_REMOTE = "org.gnome.ShairportSync.RemoteControl"
PROPS_IFACE = "org.freedesktop.DBus.Properties"

SYSTEMD_SERVICE = "org.freedesktop.systemd1"
SYSTEMD_PATH = "/org/freedesktop/systemd1"
SYSTEMD_MANAGER = "org.freedesktop.systemd1.Manager"
SYSTEMD_UNIT = "org.freedesktop.systemd1.Unit"
RECEIVER_UNIT = "shairport-sync.service"
TIMING_UNIT = "nqptp.service"

CONFIG_FILE = Path.home() / ".config/shairport-sync/shairport-sync.conf"
SYSTEM_CONFIG_FILE = Path("/etc/shairport-sync.conf")

DBUS_TIMEOUT_MS = 1000
OUTPUT_POLL_MS = 3000

# The pipewire.sink_target line as shipped (commented out = follow the system default).
SINK_TARGET_DEFAULT_LINE = ('//\tsink_target = "<sink target name>"; // Leave this commented out '
                            'to get the sink target already chosen by the PipeWire system.\n')
SINK_TARGET_LINE_RE = re.compile(r'^\s*(//)?\s*sink_target\s*=')
SINK_TARGET_VALUE_RE = re.compile(r'^\s*sink_target\s*=\s*"((?:[^"\\]|\\.)*)"\s*;(.*)$')
LABEL_MARKER = "AirPlay Receiver: "
OUTPUT_BACKEND_RE = re.compile(r'^\s*output_backend\s*=\s*"([^"]*)"')


def _first(value):
    """MPRIS lists (e.g. xesam:artist) are shown joined; scalars as-is."""
    if isinstance(value, (list, tuple)):
        return ", ".join(str(v) for v in value if v)
    return "" if value is None else str(value)


# ---- the user's shairport-sync.conf -------------------------------------

def _ensure_user_config():
    # The packaged user service seeds the per-user file from /etc on first
    # start; do the same here so it can be edited before that.
    if not CONFIG_FILE.exists() and SYSTEM_CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(SYSTEM_CONFIG_FILE, CONFIG_FILE)


def _config_lines():
    for path in (CONFIG_FILE, SYSTEM_CONFIG_FILE):
        try:
            return path.read_text().splitlines(keepends=True)
        except OSError:
            continue
    return []


def _section_bounds(lines, name):
    """Line range (start, end) of `name = { ... };`, or None if absent."""
    start = next((i for i, line in enumerate(lines)
                  if re.match(rf'^{name}\s*=', line.strip())), None)
    if start is None:
        return None
    end = next((i for i in range(start + 1, len(lines)) if lines[i].strip().startswith("};")),
               len(lines))
    return start, end


def _read_sink_target():
    """(node.name, label) from pipewire.sink_target; ("", "") means follow the default."""
    lines = _config_lines()
    bounds = _section_bounds(lines, "pipewire")
    if bounds:
        for line in lines[bounds[0]:bounds[1]]:
            match = SINK_TARGET_VALUE_RE.match(line)
            if match:
                comment = match.group(2)
                label = comment.split(LABEL_MARKER, 1)[1].strip() if LABEL_MARKER in comment else ""
                return match.group(1).replace('\\"', '"').replace("\\\\", "\\"), label
    return "", ""


def _write_sink_target(name, label):
    _ensure_user_config()
    lines = CONFIG_FILE.read_text().splitlines(keepends=True)
    if name:
        escaped = name.replace("\\", "\\\\").replace('"', '\\"')
        label = " ".join(label.split())
        new_line = f'\tsink_target = "{escaped}"; // {LABEL_MARKER}{label}\n'
    else:
        new_line = SINK_TARGET_DEFAULT_LINE

    bounds = _section_bounds(lines, "pipewire")
    if bounds is None:
        lines += ["\npipewire =\n", "{\n", new_line, "};\n"]
    else:
        start, end = bounds
        existing = next((i for i in range(start, end) if SINK_TARGET_LINE_RE.match(lines[i])), None)
        if existing is not None:
            lines[existing] = new_line
        else:
            brace = next((i for i in range(start, end) if "{" in lines[i]), start)
            lines.insert(brace + 1, new_line)

    tmp = CONFIG_FILE.with_suffix(".conf.tmp")
    tmp.write_text("".join(lines))
    os.replace(tmp, CONFIG_FILE)


def _uses_pipewire_backend():
    lines = _config_lines()
    bounds = _section_bounds(lines, "general")
    if bounds:
        for line in lines[bounds[0]:bounds[1]]:
            match = OUTPUT_BACKEND_RE.match(line)
            if match:
                return match.group(1) == "pipewire"
    return False


class Receiver(QObject):
    """Mirror of shairport-sync's D-Bus state, exposed to QML."""

    stateChanged = pyqtSignal()
    positionChanged = pyqtSignal()
    outputsChanged = pyqtSignal()
    errorOccurred = pyqtSignal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self._bus = QDBusConnection.sessionBus()
        self._state = self._empty_state()
        self._unit_state = "unknown"
        self._position = 0.0

        # Output selection. The lasting choice is pipewire.sink_target in the
        # user's config, which shairport-sync only reads at startup, so a change
        # is applied by restarting it once nothing is playing. A stream that is
        # already playing is moved straight away through PipeWire metadata.
        self._pipewire_ok = False
        self._sinks = []
        self._default_sink = ""
        self._stream_id = None
        self._output_target, self._output_label = _read_sink_target()
        self._running_target = self._output_target  # what the receiver process started with
        self._restart_pending = False

        self._pw_dump = QProcess(self)
        self._pw_dump.finished.connect(self._on_pw_dump_finished)
        self._pw_dump.errorOccurred.connect(self._on_pw_dump_error)
        self._output_timer = QTimer(self, interval=OUTPUT_POLL_MS)
        self._output_timer.timeout.connect(self.refreshOutputs)
        self._output_timer.start()
        self.refreshOutputs()

        # Coalesce bursts of PropertiesChanged signals into one refresh.
        self._refresh_timer = QTimer(self, singleShot=True, interval=50)
        self._refresh_timer.timeout.connect(self.refresh)

        self._position_timer = QTimer(self, interval=500)
        self._position_timer.timeout.connect(self._poll_position)

        self._unit_timer = QTimer(self, interval=2000)
        self._unit_timer.timeout.connect(self._poll_unit)
        self._unit_timer.start()

        for service, path in ((MPRIS_SERVICE, MPRIS_PATH), (SPS_SERVICE, SPS_PATH)):
            self._bus.connect(service, path, PROPS_IFACE, "PropertiesChanged",
                              self._on_properties_changed)

        self._watcher = QDBusServiceWatcher(
            MPRIS_SERVICE, self._bus,
            QDBusServiceWatcher.WatchModeFlag.WatchForRegistration
            | QDBusServiceWatcher.WatchModeFlag.WatchForUnregistration,
            self)
        self._watcher.serviceRegistered.connect(lambda _name: self._refresh_timer.start())
        self._watcher.serviceUnregistered.connect(lambda _name: self.refresh())

        self._poll_unit()
        self.refresh()

    @staticmethod
    def _empty_state():
        return {
            "online": False,
            "receiverName": "",
            "version": "",
            "active": False,
            "clientName": "",
            "clientAddress": "",
            "playbackStatus": "Stopped",
            "title": "",
            "artist": "",
            "album": "",
            "artUrl": "",
            "duration": 0.0,
            "volume": 0.0,
            "sourceFormat": "",
            "outputFormat": "",
        }

    # ---- QML properties ------------------------------------------------

    # Class-body helper; the signal is bound as a default because a function
    # body can't see names from the enclosing class scope.
    def _state_property(key, type_=str, notify=stateChanged):  # noqa: N805
        return pyqtProperty(type_, lambda self: self._state[key], notify=notify)

    online = _state_property("online", bool)
    receiverName = _state_property("receiverName")
    version = _state_property("version")
    active = _state_property("active", bool)
    clientName = _state_property("clientName")
    clientAddress = _state_property("clientAddress")
    playbackStatus = _state_property("playbackStatus")
    title = _state_property("title")
    artist = _state_property("artist")
    album = _state_property("album")
    artUrl = _state_property("artUrl")
    duration = _state_property("duration", float)
    volume = _state_property("volume", float)
    sourceFormat = _state_property("sourceFormat")
    outputFormat = _state_property("outputFormat")

    del _state_property

    @pyqtProperty(str, notify=stateChanged)
    def unitState(self):
        return self._unit_state

    @pyqtProperty(float, notify=positionChanged)
    def position(self):
        return self._position

    @pyqtProperty(str, constant=True)
    def configFile(self):
        return str(CONFIG_FILE)

    @pyqtProperty(bool, notify=outputsChanged)
    def outputSwitchingAvailable(self):
        return self._pipewire_ok and _uses_pipewire_backend()

    @pyqtProperty("QVariantList", notify=outputsChanged)
    def outputs(self):
        return self._sinks

    @pyqtProperty(str, notify=outputsChanged)
    def defaultOutput(self):
        return next((s["description"] for s in self._sinks if s["name"] == self._default_sink), "")

    @pyqtProperty(str, notify=outputsChanged)
    def outputTarget(self):
        return self._output_target

    @pyqtProperty(str, notify=outputsChanged)
    def outputTargetLabel(self):
        return self._output_label

    # ---- D-Bus helpers -------------------------------------------------

    def _call(self, service, path, interface, method, *args):
        msg = QDBusMessage.createMethodCall(service, path, interface, method)
        if args:
            msg.setArguments(list(args))
        reply = self._bus.call(msg, QDBus.CallMode.Block, DBUS_TIMEOUT_MS)
        if reply.type() == QDBusMessage.MessageType.ErrorMessage:
            raise RuntimeError(reply.errorMessage() or reply.errorName())
        return reply.arguments()

    def _get_all(self, service, path, interface):
        try:
            return self._call(service, path, PROPS_IFACE, "GetAll", interface)[0]
        except (RuntimeError, IndexError):
            return None

    # ---- state refresh -------------------------------------------------

    @pyqtSlot(QDBusMessage)
    def _on_properties_changed(self, _msg):
        self._refresh_timer.start()

    @pyqtSlot()
    def refresh(self):
        player = self._get_all(MPRIS_SERVICE, MPRIS_PATH, MPRIS_PLAYER)
        if player is None:
            self._set_state(self._empty_state())
            return
        core = self._get_all(SPS_SERVICE, SPS_PATH, SPS_IFACE) or {}
        remote = self._get_all(SPS_SERVICE, SPS_PATH, SPS_REMOTE) or {}
        meta = player.get("Metadata") or {}

        self._set_state({
            "online": True,
            "receiverName": core.get("ServiceName", ""),
            "version": core.get("Version", ""),
            "active": bool(core.get("Active", False)),
            "clientName": remote.get("ClientName", ""),
            "clientAddress": remote.get("Client", ""),
            "playbackStatus": player.get("PlaybackStatus", "Stopped"),
            "title": _first(meta.get("xesam:title")),
            "artist": _first(meta.get("xesam:artist")),
            "album": _first(meta.get("xesam:album")),
            "artUrl": _first(meta.get("mpris:artUrl")),
            "duration": float(meta.get("mpris:length") or 0) / 1e6,
            "volume": float(player.get("Volume", 0.0)),
            "sourceFormat": core.get("SourceFormat", ""),
            "outputFormat": core.get("OutputFormat", ""),
        })
        self._poll_position()

    def _set_state(self, new_state):
        if new_state != self._state:
            self._state = new_state
            self.stateChanged.emit()
        if self._state["playbackStatus"] == "Playing":
            self._position_timer.start()
        else:
            self._position_timer.stop()
        if not self._state["online"] and self._position:
            self._position = 0.0
            self.positionChanged.emit()
        self._apply_pending_restart()

    def _poll_position(self):
        if not self._state["online"]:
            return
        try:
            value = self._call(MPRIS_SERVICE, MPRIS_PATH, PROPS_IFACE, "Get",
                               MPRIS_PLAYER, "Position")[0]
        except (RuntimeError, IndexError):
            return
        seconds = float(value or 0) / 1e6
        if abs(seconds - self._position) > 0.05:
            self._position = seconds
            self.positionChanged.emit()

    def _poll_unit(self):
        try:
            unit_path = self._call(SYSTEMD_SERVICE, SYSTEMD_PATH, SYSTEMD_MANAGER,
                                   "LoadUnit", RECEIVER_UNIT)[0]
            unit_path = unit_path.path() if hasattr(unit_path, "path") else str(unit_path)
            state = self._call(SYSTEMD_SERVICE, unit_path, PROPS_IFACE, "Get",
                               SYSTEMD_UNIT, "ActiveState")[0]
        except (RuntimeError, IndexError):
            state = "unknown"
        if state != self._unit_state:
            self._unit_state = state
            self.stateChanged.emit()

    # ---- audio outputs -------------------------------------------------

    @pyqtSlot()
    def refreshOutputs(self):
        if self._pw_dump.state() == QProcess.ProcessState.NotRunning:
            self._pw_dump.start("pw-dump", [])

    def _on_pw_dump_error(self, _error):
        if self._pipewire_ok:
            self._pipewire_ok = False
            self.outputsChanged.emit()

    def _on_pw_dump_finished(self, _code, _status):
        try:
            objects = json.loads(bytes(self._pw_dump.readAllStandardOutput()) or b"[]")
        except ValueError:
            return

        sps_clients = set()
        nodes = []
        default_sink = ""
        stream_targets = {}
        for obj in objects:
            kind = obj.get("type", "")
            props = (obj.get("info") or {}).get("props") or {}
            if kind == "PipeWire:Interface:Client":
                if props.get("application.process.binary") == "shairport-sync":
                    sps_clients.add(obj.get("id"))
            elif kind == "PipeWire:Interface:Node":
                nodes.append((obj.get("id"), props))
            elif kind == "PipeWire:Interface:Metadata":
                if (obj.get("props") or {}).get("metadata.name") != "default":
                    continue
                for entry in obj.get("metadata") or []:
                    if entry.get("subject") == 0 and entry.get("key") == "default.audio.sink":
                        value = entry.get("value")
                        default_sink = value.get("name", "") if isinstance(value, dict) else ""
                    elif entry.get("key") == "target.object":
                        stream_targets[entry.get("subject")] = entry.get("value")

        sinks = sorted(
            ({"name": p.get("node.name", ""),
              "description": p.get("node.description") or p.get("node.nick") or p.get("node.name", "")}
             for _id, p in nodes if p.get("media.class") == "Audio/Sink"),
            key=lambda s: s["description"].casefold())
        stream_id = next((node_id for node_id, p in nodes
                          if p.get("media.class") == "Stream/Output/Audio"
                          and p.get("client.id") in sps_clients), None)

        if stream_id is not None and stream_id != self._stream_id:
            # A new receiver stream. If its process still has an older choice
            # (restart pending), or WirePlumber restored a target from someone
            # moving it elsewhere while we follow the default, put it right.
            restored = stream_targets.get(stream_id)
            if self._restart_pending or (not self._output_target and restored not in (None, -1, "-1")):
                self._move_stream(stream_id, self._output_target)
        self._stream_id = stream_id

        if (not self._pipewire_ok or sinks != self._sinks or default_sink != self._default_sink):
            self._pipewire_ok = True
            self._sinks = sinks
            self._default_sink = default_sink
            self.outputsChanged.emit()

    @staticmethod
    def _move_stream(stream_id, target):
        # By node.name, or -1 for "the default": WirePlumber then moves the stream
        # without remembering a per-app override that could outlive our choice.
        proc = QProcess()
        proc.setProgram("pw-metadata")
        proc.setArguments(["-n", "default", "--", str(stream_id), "target.object", target or "-1"])
        proc.setStandardOutputFile(QProcess.nullDevice())
        proc.startDetached()

    @pyqtSlot(str)
    def setOutput(self, name):
        if name == self._output_target:
            return
        label = next((s["description"] for s in self._sinks if s["name"] == name), "")
        try:
            _write_sink_target(name, label)
        except OSError as err:
            self.errorOccurred.emit(f"Could not save the output choice: {err}")
            return
        self._output_target, self._output_label = name, label if name else ""
        self.outputsChanged.emit()

        if self._stream_id is not None:
            self._move_stream(self._stream_id, name)
        if self._unit_state == "active":
            self._restart_pending = name != self._running_target
            self._apply_pending_restart()
        else:
            self._running_target = name  # picked up whenever it next starts

    def _apply_pending_restart(self):
        # Restarting drops a connected sender, so wait until the session is over.
        if (self._restart_pending and not self._state["active"]
                and self._state["playbackStatus"] != "Playing"):
            self._restart_pending = False
            self._manage_units("RestartUnit", (RECEIVER_UNIT,))

    # ---- actions -------------------------------------------------------

    def _player_command(self, method, *args):
        try:
            self._call(MPRIS_SERVICE, MPRIS_PATH, MPRIS_PLAYER, method, *args)
        except RuntimeError as err:
            self.errorOccurred.emit(f"{method} failed: {err}")

    @pyqtSlot()
    def playPause(self):
        self._player_command("PlayPause")

    @pyqtSlot()
    def next(self):
        self._player_command("Next")

    @pyqtSlot()
    def previous(self):
        self._player_command("Previous")

    @pyqtSlot(float)
    def setVolume(self, value):
        self._player_command("SetVolume", max(0.0, min(1.0, float(value))))

    @pyqtSlot()
    def disconnectSender(self):
        try:
            self._call(SPS_SERVICE, SPS_PATH, SPS_IFACE, "DropSession")
        except RuntimeError as err:
            self.errorOccurred.emit(f"Could not disconnect: {err}")

    def _manage_units(self, method, units):
        if method in ("StartUnit", "RestartUnit"):
            self._running_target = self._output_target
        try:
            for unit in units:
                self._call(SYSTEMD_SERVICE, SYSTEMD_PATH, SYSTEMD_MANAGER, method, unit, "replace")
        except RuntimeError as err:
            self.errorOccurred.emit(f"Could not {method[:-4].lower()} the receiver: {err}")
        QTimer.singleShot(300, self._poll_unit)

    @pyqtSlot()
    def startReceiver(self):
        # shairport-sync.service Wants= nqptp.service, so this brings up both.
        self._manage_units("StartUnit", (RECEIVER_UNIT,))

    @pyqtSlot()
    def stopReceiver(self):
        self._manage_units("StopUnit", (RECEIVER_UNIT, TIMING_UNIT))

    @pyqtSlot()
    def restartReceiver(self):
        self._manage_units("RestartUnit", (TIMING_UNIT, RECEIVER_UNIT))

    @pyqtSlot()
    def openConfig(self):
        _ensure_user_config()
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(CONFIG_FILE)))


def main():
    # Use Plasma's own Qt Quick Controls style so the window matches the desktop.
    os.environ.setdefault("QT_QUICK_CONTROLS_STYLE", "org.kde.desktop")

    app = QApplication(sys.argv)
    app.setApplicationName("shairport-sync-gui")
    app.setOrganizationName("shairport-sync")
    # Matches shairport-sync's MPRIS DesktopEntry, so Plasma ties the two together.
    app.setDesktopFileName("shairport-sync")
    app.setWindowIcon(QIcon.fromTheme("shairport-sync", QIcon(str(HERE / "shairport-sync.svg"))))

    receiver = Receiver()
    engine = QQmlApplicationEngine()
    engine.setInitialProperties({"receiver": receiver})
    engine.load(QUrl.fromLocalFile(str(HERE / "qml" / "Main.qml")))
    if not engine.rootObjects():
        return 1
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
