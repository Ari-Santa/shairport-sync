#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PKG := debian/shairport-sync-desktop
GUI_DIR := /usr/share/shairport-sync-gui

%:
	dh $@

override_dh_autoreconf:
	@test -f nqptp/configure.ac || \
		{ echo "nqptp/ is empty: run 'git submodule update --init' first" >&2; exit 1; }
	dh_autoreconf
	cd nqptp && autoreconf -fi

override_dh_auto_configure:
	dh_auto_configure -- \
		--with-airplay-2 \
		--with-alsa \
		--with-avahi \
		--with-dbus-interface \
		--with-mpris-interface \
		--with-pipewire \
		--with-pulseaudio \
		--with-soxr \
		--with-ssl=openssl
	dh_auto_configure -Dnqptp

override_dh_auto_build:
	dh_auto_build
	dh_auto_build -Dnqptp

override_dh_auto_install:
	# The D-Bus policy files are only for the system bus; this package puts
	# both interfaces on the session bus, so stage them aside and drop them.
	dh_auto_install -- DBUS_POLICY_DIR=/dbus-policy-unused
	rm -r $(PKG)/dbus-policy-unused
	dh_auto_install -Dnqptp

	# Default settings for a desktop session receiver.
	sed -i \
		-e 's|^//\toutput_backend = "alsa";|\toutput_backend = "pipewire";|' \
		-e 's|^//\tdbus_service_bus = "system";|\tdbus_service_bus = "session";|' \
		-e 's|^//\tmpris_service_bus = "system";|\tmpris_service_bus = "session";|' \
		-e 's|^//\tenabled = "yes"; // set this to yes to get Shairport Sync to solicit metadata|\tenabled = "yes"; // set this to yes to get Shairport Sync to solicit metadata|' \
		-e 's|^//\tinclude_cover_art = "yes";|\tinclude_cover_art = "yes";|' \
		$(PKG)/etc/shairport-sync.conf
	test $$(grep -c -P '^\t(output_backend = "pipewire"|dbus_service_bus = "session"|mpris_service_bus = "session"|enabled = "yes"|include_cover_art = "yes")' \
		$(PKG)/etc/shairport-sync.conf) -eq 5

	install -D -m 0644 debian/shairport-sync.user-unit $(PKG)/usr/lib/systemd/user/shairport-sync.service
	install -D -m 0644 debian/nqptp.user-unit $(PKG)/usr/lib/systemd/user/nqptp.service

	install -D -m 0755 gui/shairport-sync-gui $(PKG)$(GUI_DIR)/shairport-sync-gui
	install -D -m 0644 gui/qml/Main.qml $(PKG)$(GUI_DIR)/qml/Main.qml
	install -D -m 0644 gui/shairport-sync.svg $(PKG)$(GUI_DIR)/shairport-sync.svg
	install -D -m 0644 gui/shairport-sync.svg $(PKG)/usr/share/icons/hicolor/scalable/apps/shairport-sync.svg
	install -D -m 0644 gui/shairport-sync.desktop $(PKG)/usr/share/applications/shairport-sync.desktop
	install -d $(PKG)/usr/bin
	ln -s ../share/shairport-sync-gui/shairport-sync-gui $(PKG)/usr/bin/shairport-sync-gui

# Enable the receiver for every user at login; it pulls in nqptp.service itself.
override_dh_installsystemduser:
	dh_installsystemduser shairport-sync.service

override_dh_auto_clean:
	dh_auto_clean
	[ ! -f nqptp/Makefile ] || dh_auto_clean -Dnqptp
