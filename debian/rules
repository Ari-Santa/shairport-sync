#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PKG := debian/shairport-sync-desktop
GUI_DIR := /usr/share/shairport-sync-gui

%:
	dh $@

override_dh_autoreconf:
	@test -f nqptp/configure.ac || \
		{ echo "nqptp/ is empty: run 'git submodule update --init' first" >&2; exit 1; }
	dh_autoreconf
	cd nqptp && autoreconf -fi

override_dh_auto_configure:
	dh_auto_configure -- \
		--with-airplay-2 \
		--with-alsa \
		--with-avahi \
		--with-dbus-interface \
		--with-mpris-interface \
		--with-pipewire \
		--with-pulseaudio \
		--with-soxr \
		--with-ssl=openssl
	dh_auto_configure -Dnqptp

override_dh_auto_build:
	dh_auto_build
	dh_auto_build -Dnqptp

override_dh_auto_install:
	# The D-Bus policy files are only for the system bus; this package puts
	# both interfaces on the session bus, so stage them aside and drop them.
	dh_auto_install -- DBUS_POLICY_DIR=/dbus-policy-unused
	rm -r $(PKG)/dbus-policy-unused
	dh_auto_install -Dnqptp

	# The desktop defaults, from which each user's copy is made, get a name
	# of their own: /etc/shairport-sync.conf is the distribution's
	# shairport-sync conffile, and taking it over can keep that package's
	# edited copy instead. The stock sample is left out, as the defaults
	# file has every setting and its explanation too.
	mv $(PKG)/etc/shairport-sync.conf $(PKG)/etc/shairport-sync-desktop.conf
	rm $(PKG)/etc/shairport-sync.conf.sample
	sh packaging/apply-desktop-defaults.sh $(PKG)/etc/shairport-sync-desktop.conf

	install -D -m 0644 packaging/shairport-sync.service $(PKG)/usr/lib/systemd/user/shairport-sync.service
	install -D -m 0644 packaging/nqptp.service $(PKG)/usr/lib/systemd/user/nqptp.service
	install -D -m 0644 packaging/airplay-receiver.xml $(PKG)/usr/lib/firewalld/services/airplay-receiver.xml

	install -D -m 0755 gui/shairport-sync-gui $(PKG)$(GUI_DIR)/shairport-sync-gui
	install -D -m 0644 gui/qml/Main.qml $(PKG)$(GUI_DIR)/qml/Main.qml
	install -D -m 0644 gui/shairport-sync.svg $(PKG)$(GUI_DIR)/shairport-sync.svg
	install -D -m 0644 gui/shairport-sync.svg $(PKG)/usr/share/icons/hicolor/scalable/apps/shairport-sync.svg
	install -D -m 0644 gui/shairport-sync.desktop $(PKG)/usr/share/applications/shairport-sync.desktop
	install -d $(PKG)/usr/bin
	ln -s ../share/shairport-sync-gui/shairport-sync-gui $(PKG)/usr/bin/shairport-sync-gui
	install -D -m 0644 packaging/shairport-sync-gui.1 $(PKG)/usr/share/man/man1/shairport-sync-gui.1

# Upstream's README and the app's, which is named README.gui.md as in the RPM.
override_dh_installdocs:
	dh_installdocs README.md
	install -m 0644 gui/README.md $(PKG)/usr/share/doc/shairport-sync-desktop/README.gui.md

# Enable the receiver for every user at login (the unit itself skips system
# accounts); it pulls in nqptp.service itself.
override_dh_installsystemduser:
	dh_installsystemduser shairport-sync.service

override_dh_auto_clean:
	dh_auto_clean
	[ ! -f nqptp/Makefile ] || dh_auto_clean -Dnqptp
